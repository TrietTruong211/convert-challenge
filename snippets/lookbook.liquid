{% comment %}
  Shared lookbook component.
  Params:
    - title             {String}  Section heading
    - description       {String}  Optional subheading from metaobject
    - product_handles   {Array}   List of product handle strings
    - section_id        {String}  Section ID for Alpine scoping
{% endcomment %}

<div
  class="lookbook-section page-width py-16"
  x-data="lookbookSection"
  data-section-id="{{ section_id }}"
  data-product-handles="{{ product_handles | json | escape }}"
  data-country="{{ localization.country.iso_code }}"
>
  {% if title != blank %}
    <h2 class="mb-4 text-7xl font-bold tracking-tight">{{ title }}</h2>
  {% endif %}
  {% if description != blank %}
    <p class="mb-10 text-2xl text-gray-500">{{ description }}</p>
  {% else %}
    <div class="mb-10"></div>
  {% endif %}

  <div x-show="loading" class="grid grid-cols-2 gap-4 md:grid-cols-4">
    <template x-for="i in skeletonCount" :key="i">
      <div>
        <div class="aspect-[3/4] w-full animate-pulse bg-slate-200"></div>
        <div class="mt-2 h-6 w-2/3 animate-pulse rounded bg-slate-200"></div>
        <div class="mt-1 h-5 w-1/3 animate-pulse rounded bg-slate-200"></div>
      </div>
    </template>
  </div>

  <div x-show="!loading && looks.length > 0" class="grid grid-cols-2 gap-4 md:grid-cols-4">
    <template x-for="look in looks" :key="look.handle">
      <div>
        <a :href="look.url" class="block">
          <img
            x-show="look.image"
            :src="look.image || ''"
            :alt="look.imageAlt"
            width="300"
            height="400"
            class="aspect-[3/4] w-full object-cover"
            loading="lazy"
          >
          <div x-show="!look.image" class="aspect-[3/4] w-full bg-gray-100"></div>
        </a>

        <div class="mt-3">
          <p class="text-3xl font-medium" x-text="look.title"></p>
          <div class="mt-1 flex items-center gap-3">
            <span class="text-2xl text-gray-700">
              {{ localization.country.currency.symbol }}<span x-text="look.price"></span> {{ localization.country.currency.iso_code }}
            </span>
            <s x-show="look.compareAtPrice" class="text-2xl text-gray-400">
              {{ localization.country.currency.symbol }}<span x-text="look.compareAtPrice"></span> {{ localization.country.currency.iso_code }}
            </s>
          </div>
        </div>
      </div>
    </template>
  </div>

  <p x-show="!loading && error" class="text-3xl text-gray-400">Failed to load products.</p>
  <p x-show="!loading && !error && looks.length === 0" class="text-3xl text-gray-400">No products in this lookbook.</p>
</div>
